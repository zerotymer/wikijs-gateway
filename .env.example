# Wiki.js internal GraphQL endpoint
WIKIJS_GRAPHQL_URL=http://wiki:3000/graphql

# Wiki.js read-only API token (read:pages, read:source)
WIKIJS_API_TOKEN=your_wikijs_read_token_here

# Wiki.js write API token (read:pages, read:source, write:pages)
WIKIJS_ADMIN_API_TOKEN=your_wikijs_admin_token_here

# Gateway bearer token for read-only access (health, page read, search, by-paths)
GATEWAY_TOKEN=your_gateway_token_here

# Gateway bearer token for admin access (dry-run, patch-section, upsert, bulk)
GATEWAY_ADMIN_TOKEN=your_gateway_admin_token_here

# Gateway operation mode: read_only | dry_run | write
GATEWAY_MODE=read_only

# Default locale for page queries
DEFAULT_LOCALE=ko

# Comma-separated path prefixes allowed for write operations
ALLOW_PATH_PREFIXES=/agent,/draft

# Directory for audit log files (optional, default: /audit)
AUDIT_DIR=/audit

# Call pages.render after successful write (optional, default: false)
RENDER_AFTER_WRITE=false

# Maximum number of items per batch request (optional, default: 50)
BATCH_MAX_SIZE=50

# Maximum concurrent tasks per batch request (optional, default: 10)
BATCH_CONCURRENCY=10

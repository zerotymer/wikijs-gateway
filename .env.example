# Wiki.js internal GraphQL endpoint
WIKIJS_GRAPHQL_URL=http://wiki:3000/graphql

# Wiki.js API token (permissions managed by Wiki.js)
WIKIJS_API_TOKEN=your_wikijs_token_here

# Gateway bearer token required for write endpoints (dry-run, patch-section, upsert)
GATEWAY_ADMIN_TOKEN=your_gateway_admin_token_here

# Rust gateway only: Host allow-list for /api/v2/mcp (comma-separated).
# Unset = loopback only (rmcp default, DNS-rebinding guard) -> public hostnames get 403.
# Must be set when serving MCP behind a reverse proxy. "*" disables the check.
MCP_ALLOWED_HOSTS=md-gw.zerotymer.net,md-gw.internal.zerotymer.net
